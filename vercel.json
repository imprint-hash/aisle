{
 "outputDirectory": "public",
 "cleanUrls": true,
 "functions": {
  "api/rank.mjs": {
   "maxDuration": 60,
   "includeFiles": "{data,lib}/**"
  },
  "api/consider.mjs": {
   "maxDuration": 60,
   "includeFiles": "{data,lib}/**"
  },
  "api/wrap.mjs": {
   "maxDuration": 60
  },
  "api/campaign.mjs": {
   "maxDuration": 60,
   "includeFiles": "{data,lib}/**"
  }
 },
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "no-referrer"
    },
    {
     "key": "Content-Security-Policy",
     "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/v1/:path*",
   "destination": "/api/wrap?__p=:path*"
  },
  {
   "source": "/consider",
   "destination": "/api/consider"
  },
  {
   "source": "/.well-known/x402",
   "destination": "/api/wrap?__p=__wk"
  },
  {
   "source": "/healthz",
   "destination": "/api/wrap?__p=__health"
  }
 ]
}